# Copy to .env and fill in the keys. Every other value is optional; the defaults are shown.

OPENAI_API_KEY=
ELEVENLABS_API_KEY=

# ---- Camera: device index (0, 1, ...) or an rtsp:// / http:// URL, or a video file
CAM_SOURCE=0
SHOW_LIVE=1
ROAST_AUTOSTART=0            # 1 = auto roasting is on from the start
TRY_CAMERA_LOW_LIGHT=1
# CAMERA_EXPOSURE=
# CAMERA_GAIN=
# CAMERA_BRIGHTNESS=
DARK_LUMA_THRESH=40
CAMERA_TIMEOUT_SEC=5        # give up one connection attempt after this
CAMERA_RETRY_SEC=5          # the app runs without a picture and retries this often until the camera answers
CAMERA_STALL_SEC=5          # no frames this long -> reconnect (stream dropped, camera rebooted)

# ---- Detection / presence
MIN_MOTION_PIXELS=1500       # motion needed before YOLO runs (only while nobody has been seen recently)
YOLO_CONF_DAY=0.4
YOLO_CONF_NIGHT=0.6
YOLO_USE_NIGHT_CONF_WHEN_DARK=1
YOLO_IMGSZ=640               # smaller = faster detection; 416 is fine for kids at a door
YOLO_MAX_HZ=10               # detection rate cap; the video is still drawn at full rate
TORCH_THREADS=0              # CPU threads for YOLO; 0 = auto (a third of the logical CPUs, max 4). More is slower, not faster.
PERSON_CONFIRM_SEC=0.5       # a person must be seen this long before the skeletons react
PERSON_GAP_SEC=0.4           # missed detections shorter than this do not reset the timer
PERSON_TRACK_SEC=2.0         # keep running YOLO this long after the last person, even without motion
YOLO_IDLE_INTERVAL_SEC=1.0   # run YOLO at least this often even without motion
BEST_FRAME_WINDOW_SEC=1.0    # the best-looking frame from this window is sent to the model
REARM_CLEAR_SEC=3.0          # scene empty this long after a joke -> ready for the next group
REARM_SAME_SCENE_SEC=30      # same group still standing there -> next joke after this long

# ---- Jokes (OpenAI)
LLM_MODEL=gpt-6-luna         # try gpt-6-sol if the jokes feel flat
LLM_REASONING_EFFORT=none    # none = fastest; leave empty for models without reasoning
LLM_IMAGE_MAX_SIDE=768       # the crop around the kids is resized to this before sending
LLM_IMAGE_DETAIL=low         # low = fastest (about 2 s); auto/high see more detail but take longer
# LLM_SERVICE_TIER=priority  # OpenAI priority processing: about 1.7 s per joke, roughly double the price
LLM_TIMEOUT_SEC=20
JOKE_HISTORY_SIZE=6          # recent jokes passed to the model so it does not repeat itself

# ---- Voices (ElevenLabs)
ELEVEN_MODEL=eleven_flash_v2_5
ELEVEN_OUTPUT_FORMAT=pcm_24000   # pcm_* streams straight to the speaker; mp3_44100_128 falls back to pygame
# AUDIO_OUTPUT_DEVICE=           # index or part of the output device name
VOICE_SKALLEPAR=NHVO1d5lgqVtAvyYNL2P
VOICE_BENRANGEL=S6pZEFGfrgnWx4AETPdD

# ---- Mic / talk-back
# MIC_DEVICE=                 # index or part of the input device name (PREM_MIC_DEVICE still works)
MIC_AUTOSTART=0              # 1 = mic mode on from the start
MIC_ACTION=talkback          # talkback = transcribe and answer; premade = old behaviour (play a premade pair)
MIC_END_SILENCE_MS=600       # silence that ends an utterance
MIC_MIN_SPEECH_MS=250        # shorter blips are ignored
MIC_MAX_UTTERANCE_SEC=8
MIC_MUTE_TAIL_MS=500         # keep the mic muted this long after the skeletons stop talking
MIC_COOLDOWN_SEC=10          # premade mode only
MIC_DEBUG=0
STT_MODEL=gpt-4o-mini-transcribe
STT_LANGUAGE=sv
STT_MIN_CHARS=3
DIALOGUE_HISTORY_SIZE=4      # earlier exchanges given to the model in talk-back mode
DIALOGUE_RESET_SEC=90

# ---- Media
PREMADE_DIR=media/premade    # one subfolder per pair: skalle*.mp3 + ben*.mp3
ATTENTION_DIR=media/attention  # played while the joke is generated
FILLER_DIR=media/filler      # played while an answer is generated in talk-back mode (falls back to attention clips)

# ---- UI
SUBTITLE_HOLD_SEC=2.5        # keep the last line on screen this long after it was spoken
# SUBTITLE_FONT=              # path to a .ttf if you do not want Segoe UI / Arial

# ---- Tapo / ONVIF events (optional)
TAPO_ENABLE_EVENTS=0
# TAPO_HOST=
# TAPO_USER=
# TAPO_PASSWORD=
TAPO_ONVIF_PORT=2020
TAPO_POLL_SECONDS=1.0
TAPO_USE_ONLY_WHEN_DARK=1
